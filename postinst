#!/bin/sh
# XLH VideoGrab 安装后处理

JB=/var/jb
[ -d "$JB" ] || JB=""

# 1) 可执行权限（部分文件系统打包时会丢执行位）
chmod 755 "$JB/usr/bin/xlgrab" 2>/dev/null || true
chmod 755 /usr/bin/xlgrab 2>/dev/null || true

# 2) 确保 ElleKit / TweakInject 目录能看到本插件
DYLIB="$JB/Library/MobileSubstrate/DynamicLibraries/XLHVideoGrab.dylib"
PLIST="$JB/Library/MobileSubstrate/DynamicLibraries/XLHVideoGrab.plist"
TI="$JB/usr/lib/TweakInject"
if [ -d "$TI" ] && [ -f "$DYLIB" ] && [ ! -e "$TI/XLHVideoGrab.dylib" ]; then
    ln -sf "$DYLIB" "$TI/XLHVideoGrab.dylib" 2>/dev/null || true
    ln -sf "$PLIST" "$TI/XLHVideoGrab.plist" 2>/dev/null || true
fi

# 3) 配置目录
mkdir -p /var/mobile/Library/Preferences/xlhgrab 2>/dev/null || true
chown mobile:mobile /var/mobile/Library/Preferences/xlhgrab 2>/dev/null || true

exit 0
